# SQLite database (path is relative to prisma/schema.prisma)
DATABASE_URL=file:../db/custom.db

# Public base URL used for Open Graph metadata
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 1 to log every Prisma query
# PRISMA_LOG_QUERIES=0

# Opt out of Next.js anonymous build telemetry
NEXT_TELEMETRY_DISABLED=1
